<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Targets the latest .NET 9 hosting runtime baseline -->
    <TargetFramework>net9.0</TargetFramework>

    <!-- Enforces strict compiler rules requiring explicit null validation patterns -->
    <Nullable>enable</Nullable>

    <!-- Enables modern C# features like primary constructors and collection expressions -->
    <ImplicitUsings>enable</ImplicitUsings>

    <AssemblyName>EcommerceRecommender.WebApi</AssemblyName>
    <RootNamespace>WebApi</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Framework & SDK Orchestration Engines -->
    <PackageReference Include="NETStandard.Library" Version="2.0.3" />
    <PackageReference Include="MediatR" Version="12.4.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Clean Architecture Downstream Project Dependencies -->
    <ProjectReference Include="..\2.Application\Application.csproj" />
    <ProjectReference Include="..\3.Infrastructure\Infrastructure.csproj" />
  </ItemGroup>

</Project>
